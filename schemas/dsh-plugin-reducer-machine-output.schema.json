{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh-plugin-reducer machine output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "operation", "ok"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "dsh-plugin-reducer" },
        "version": { "type": "string" }
      }
    },
    "operation": { "enum": ["reduce", "list-candidates"] },
    "ok": { "type": "boolean" },
    "profile": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "report": { "$ref": "./dsh-plugin-reducer-report.schema.json" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    },
    {
      "if": {
        "properties": {
          "ok": { "const": true },
          "operation": { "const": "reduce" }
        }
      },
      "then": { "required": ["report"] }
    },
    {
      "if": {
        "properties": {
          "ok": { "const": true },
          "operation": { "const": "list-candidates" }
        }
      },
      "then": { "required": ["profile", "candidates"] }
    }
  ]
}
